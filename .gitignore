# Godot 4
.godot/
.import/                  # Godot 3 import cache
# Godot 4 editor sidecars — regenerated when the project is opened
**/*.uid
**/*.import
export_presets.cfg

# Godot Android build template (generated, ~1GB) and export outputs
android/
*.apk
*.aab
*.idsig

# Godot iOS export outputs (large generated binaries; re-export locally)
**/Click Rush Seeker/**
!**/Click Rush Seeker/.gdignore
**/Click Rush Seeker.xcodeproj/**
!**/Click Rush Seeker.xcodeproj/.gdignore
**/Click Rush Seeker.xcframework/**
!**/Click Rush Seeker.xcframework/.gdignore
**/MoltenVK.xcframework/**
!**/MoltenVK.xcframework/.gdignore
**/*.pck
**/*.ipa
**/*.xcarchive
**/PrivacyInfo.xcprivacy

# OS / editor
.DS_Store
*.tmp
graphify-out/

# Kenney mobile controls — full pack optional locally; repo only tracks SVGs wired in code.
seeker-dash/ui/mobile-controls/Sprites/
seeker-dash/ui/mobile-controls/Spritesheets/
seeker-dash/ui/mobile-controls/Preview.png
seeker-dash/ui/mobile-controls/Vector/Highlights A/
seeker-dash/ui/mobile-controls/Vector/Highlights B/
